# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env.local" (for your computer) and fill it in.
#  On Vercel / Netlify, add the SAME names + values in the
#  "Environment Variables" settings page instead (see README.md).
# ─────────────────────────────────────────────────────────────

# 1) Firebase web config — copy from Firebase console →
#    Project settings → General → "Your apps" → SDK setup and configuration → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2) PIN for the hidden /admin page (digits or letters, your choice)
VITE_ADMIN_PIN=
